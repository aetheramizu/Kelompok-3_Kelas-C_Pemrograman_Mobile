rules_version = '2';

// NearPace Firestore access control.
// Deploy with: firebase deploy --only firestore:rules --project nearpace-cb748
// Test with:   firebase emulators:exec --only firestore "npm test" (or the console Rules Playground)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in groupDoc(groupId).memberUids;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && groupDoc(groupId).ownerUid == request.auth.uid;
    }

    // Private profile and private activity history. Only the owner may read or write.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /activities/{activityId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (!request.resource.data.keys().hasAny(['distanceM', 'durationS'])
              || (request.resource.data.distanceM is number
                  && request.resource.data.distanceM >= 0
                  && request.resource.data.durationS is number
                  && request.resource.data.durationS >= 0));
      }
    }

    // Public weekly aggregates. Anyone may read; a user may only write
    // the document that belongs to them, and the document id must match weekKey_uid.
    // Supports optional `avatarId` without blocking legacy documents that omit it.
    match /leaderboard/{entryId} {
      allow read: if true;

      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && entryId == request.resource.data.weekKey + '_' + request.auth.uid
        && request.resource.data.weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(
             ['uid', 'displayName', 'city', 'weekKey', 'distanceM', 'runCount', 'updatedAt', 'avatarId'])
        && (!request.resource.data.keys().hasAny(['avatarId'])
            || request.resource.data.avatarId == null
            || (request.resource.data.avatarId is string && request.resource.data.avatarId.size() <= 40))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 60
        && request.resource.data.weekKey is string
        && request.resource.data.distanceM is number
        && request.resource.data.distanceM >= 0
        && request.resource.data.distanceM <= 1000000
        && (request.resource.data.runCount is int || request.resource.data.runCount is number)
        && request.resource.data.runCount >= 0
        && request.resource.data.updatedAt is timestamp;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Private running circles / groups and their weekly member standings.
    match /groups/{groupId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && (!request.resource.data.keys().hasAny(['description'])
            || request.resource.data.description == null
            || (request.resource.data.description is string && request.resource.data.description.size() <= 160))
        && (!request.resource.data.keys().hasAny(['weeklyGoalKm'])
            || request.resource.data.weeklyGoalKm == null
            || (request.resource.data.weeklyGoalKm is number
                && request.resource.data.weeklyGoalKm > 0
                && request.resource.data.weeklyGoalKm <= 1000))
        && request.resource.data.maxMembers is int
        && request.resource.data.maxMembers >= 2
        && request.resource.data.maxMembers <= 200
        && request.resource.data.createdAt is timestamp;

      // Owner may update metadata (without changing ownerUid/inviteCode);
      // signed-in non-owner may ONLY add or remove themselves in `memberUids`
      // without modifying ownerUid, name, inviteCode, or other metadata.
      allow update: if signedIn() && (
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50
          && (!request.resource.data.keys().hasAny(['description'])
              || request.resource.data.description == null
              || (request.resource.data.description is string && request.resource.data.description.size() <= 160))
          && (!request.resource.data.keys().hasAny(['weeklyGoalKm'])
              || request.resource.data.weeklyGoalKm == null
              || (request.resource.data.weeklyGoalKm is number
                  && request.resource.data.weeklyGoalKm > 0
                  && request.resource.data.weeklyGoalKm <= 1000)))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.name == resource.data.name
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.memberUids is list
          && (
            // Self-join: adds only request.auth.uid while under maxMembers
            (!(request.auth.uid in resource.data.memberUids)
              && request.auth.uid in request.resource.data.memberUids
              && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
              && request.resource.data.memberUids.hasAll(resource.data.memberUids)
              && request.resource.data.memberUids.size() <= resource.data.maxMembers)
            ||
            // Self-leave: removes only request.auth.uid (non-owner)
            (resource.data.ownerUid != request.auth.uid
              && request.auth.uid in resource.data.memberUids
              && !(request.auth.uid in request.resource.data.memberUids)
              && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
              && resource.data.memberUids.hasAll(request.resource.data.memberUids))
          ))
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if isGroupMember(groupId);

        allow create, update: if isOwner(uid)
          && isGroupMember(groupId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['uid', 'displayName', 'avatarId', 'weekKey', 'distanceM', 'runCount', 'avgPaceSecPerKm', 'updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 40
          && (!request.resource.data.keys().hasAny(['avatarId'])
              || request.resource.data.avatarId == null
              || (request.resource.data.avatarId is string && request.resource.data.avatarId.size() <= 40))
          && request.resource.data.weekKey is string
          && request.resource.data.weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.distanceM is number
          && request.resource.data.distanceM >= 0
          && request.resource.data.distanceM <= 1000000
          && (request.resource.data.runCount is int || request.resource.data.runCount is number)
          && request.resource.data.runCount >= 0
          && (!request.resource.data.keys().hasAny(['avgPaceSecPerKm'])
              || request.resource.data.avgPaceSecPerKm == null
              || (request.resource.data.avgPaceSecPerKm is number && request.resource.data.avgPaceSecPerKm > 0))
          && request.resource.data.updatedAt is timestamp;

        allow delete: if isOwner(uid) || isGroupOwner(groupId);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
